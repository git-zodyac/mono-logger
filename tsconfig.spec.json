{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "vitest.config.ts",
    "src/setup.vitest.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
